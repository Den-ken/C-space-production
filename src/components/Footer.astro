---
import Logo from './Logo.astro';
import { contact } from '../data/site';
const wa = contact.whatsapp.replace(/\D/g, '');
const year = new Date().getFullYear();
const nav = [
  ['#nosotros', 'Nosotros'],
  ['#servicios', 'Servicios'],
  ['#creadores', 'Creadores'],
  ['#contacto', 'Contacto'],
];
const hasContact = Boolean(contact.email || contact.phone || wa);
const cols = 2 + (contact.social.length > 0 ? 1 : 0); // navegar + contacto (+ redes)
---
<footer class="foot">
  <div class="top" style={`--n:${cols}`}>
    <div class="brand">
      <a href="#top" class="flogo" aria-label="SPACE Producciones, volver al inicio"><Logo /></a>
      <p>Podcasts, directos y creadores. Producción digital para las plataformas donde pasa todo.</p>
    </div>

    <nav aria-label="Pie de página" class="col">
      <h2 class="mono">Navegar</h2>
      <ul>{nav.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
    </nav>

    <div class="col">
      <h2 class="mono">Contacto</h2>
      {hasContact ? (
        <ul>
          {contact.email && <li><a href={`mailto:${contact.email}`}>{contact.email}</a></li>}
          {contact.phone && <li><a href={`tel:${contact.phone.replace(/[^+\d]/g, '')}`}>{contact.phone}</a></li>}
          {wa && <li><a href={`https://wa.me/${wa}`} target="_blank" rel="noopener">WhatsApp</a></li>}
        </ul>
      ) : (
        <p class="soft">Escríbenos en el <a class="ul" href="#contacto">formulario de contacto</a>.</p>
      )}
    </div>

    {contact.social.length > 0 && (
      <div class="col">
        <h2 class="mono">Redes</h2>
        <ul>{contact.social.map((s) => <li><a href={s.url} target="_blank" rel="noopener">{s.label}</a></li>)}</ul>
      </div>
    )}
  </div>

  <div class="bar mono">
    <span>© {year} SPACE PRODUCCIONES</span>
    <span class="demo">+18 · Sitio en desarrollo · contenido de demostración</span>
    <a href="#top" class="up">Volver arriba ↑</a>
  </div>
</footer>
<style>
  .foot { background: var(--black); border-top: 1px solid var(--line); padding: clamp(3rem, 6vw, 5rem) var(--pad) 1.6rem; }
  .top { display: grid; grid-template-columns: 1.6fr repeat(var(--n, 2), minmax(0, 1fr)); gap: clamp(2rem, 5vw, 5rem); align-items: start; }
  .brand p { margin-top: 1.2rem; max-width: 22rem; color: var(--warm); opacity: .7; font-size: .95rem; line-height: 1.6; }
  .flogo { --lh: 3.4rem; display: inline-block; }
  .flogo:hover { --lc2: var(--gold-lit); }
  .col h2 { font-family: var(--f-mono); font-size: .72rem; letter-spacing: .14em; text-transform: uppercase; line-height: 1.4; color: var(--gold); margin-bottom: 1.1rem; }
  .col ul { list-style: none; display: grid; gap: .55rem; }
  .col a { display: inline-block; padding: .15rem 0; color: var(--warm); opacity: .85; transition: color .3s, opacity .3s; }
  .col a:hover, .col a:focus-visible { color: var(--gold-lit); opacity: 1; }
  .soft { color: var(--warm); opacity: .7; font-size: .95rem; line-height: 1.6; max-width: 16rem; }
  .ul { text-decoration: underline; text-underline-offset: .25em; }
  .bar { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: .8rem 2rem; margin-top: clamp(3rem, 6vw, 5rem); padding: 1.4rem 5rem 0 0; border-top: 1px solid var(--line); font-size: .7rem; color: var(--warm); }
  .bar > span { opacity: .65; }
  .bar .up { color: var(--gold); padding: .4rem 0; transition: color .3s; }
  .bar .up:hover, .bar .up:focus-visible { color: var(--gold-lit); }
  @media (max-width: 860px) { .top { grid-template-columns: 1fr 1fr; } .brand { grid-column: 1 / -1; } }
  @media (max-width: 520px) { .top { grid-template-columns: 1fr; } .bar { flex-direction: column; align-items: flex-start; } }
</style>
