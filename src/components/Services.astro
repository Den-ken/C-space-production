---
import { services } from '../data/site';
---
<section class="section services" id="servicios" aria-labelledby="serv-h">
  <div class="wrap">
    <div class="side">
      <p class="label mono" data-reveal>Canal 02 — Servicios</p>
      <h2 id="serv-h" data-split>Lo que <em>hacemos</em></h2>

      <div class="monitor" aria-hidden="true">
        <div class="screen scene" data-tone="0">
          {services.map((s, i) => (
            <img src={s.image} alt="" loading="lazy" decoding="async" class={i === 0 ? 'on' : ''} />
          ))}
          <span class="tag-temp">Foto de stock</span>
        </div>
        <i class="c c1"></i><i class="c c2"></i><i class="c c3"></i><i class="c c4"></i>
        <p class="mon-bar mono"><span><b class="rec"></b> CANAL <span class="mon-n">01</span> / {String(services.length).padStart(2, '0')}</span><span>SPACE PRODUCCIONES</span></p>
      </div>
    </div>

    <ol class="list">
      {services.map((s) => (
        <li class="row">
          <span class="n mono">{s.n}</span>
          <div class="body">
            <h3>{s.name}</h3>
            {s.note && <p class="note">{s.note}</p>}
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
<style>
  .services { background: var(--carbon); }
  .wrap { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(2rem, 6vw, 7rem); align-items: start; }

  /* columna izquierda fija: título + monitor */
  .side { position: sticky; top: 6.5rem; }
  .side h2 { font-size: clamp(2.2rem, 4.4vw, 4.6rem); margin-bottom: 2.5rem; }

  .monitor { position: relative; padding: .9rem; }
  .screen { aspect-ratio: 4/3; background: var(--black); }
  .screen img { opacity: 0; transition: opacity .7s var(--ease), transform 1.2s var(--ease); transform: scale(1.06); }
  .screen img.on { opacity: 1; transform: none; }
  .c { position: absolute; width: 18px; height: 18px; border: 0 solid var(--gold); }
  .c1 { top: 0; left: 0; border-width: 1px 0 0 1px; } .c2 { top: 0; right: 0; border-width: 1px 1px 0 0; }
  .c3 { bottom: 0; left: 0; border-width: 0 0 1px 1px; } .c4 { bottom: 0; right: 0; border-width: 0 1px 1px 0; }
  .mon-bar { display: flex; justify-content: space-between; margin-top: .9rem; color: var(--gold); font-size: .68rem; }
  .rec { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #e23b3b; margin-right: .3rem; animation: blink 1.2s steps(2) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .rec { animation: none; } }

  /* lista */
  .list { list-style: none; counter-reset: none; border-top: 1px solid var(--line); }
  .row { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; padding: 1.5rem 0 1.6rem; border-bottom: 1px solid var(--line); position: relative; }
  .row::before { content: ''; position: absolute; left: 0; bottom: -1px; height: 1px; width: 100%; background: var(--gold-lit); transform: scaleX(0); transform-origin: left; transition: transform .6s var(--ease); }
  .row.on::before { transform: scaleX(1); }
  .n { color: var(--gold); padding-top: .55em; transition: color .3s; }
  .row h3 { font-size: clamp(1.6rem, 2.8vw, 2.6rem); line-height: 1; color: var(--warm); transition: color .3s, transform .5s var(--ease); }
  .note { margin-top: .55rem; font-size: .95rem; line-height: 1.5; color: var(--warm); opacity: .7; max-width: 26rem; }
  .row.on h3 { color: var(--gold-lit); transform: translateX(.5rem); }
  .row.on .n { color: var(--white); }

  @media (max-width: 860px) {
    .wrap { grid-template-columns: 1fr; gap: 2.5rem; }
    .side { position: static; }
    .side h2 { margin-bottom: 0; }
    .monitor { display: none; }
    .row { grid-template-columns: 2.4rem 1fr; padding: 1.2rem 0; }
    .row.on h3 { transform: none; }
  }
</style>
